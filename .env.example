# --- required ---
APP_PASSWORD=choose-a-long-password          # the web page asks for this (any username)
ACTUAL_SERVER_URL=http://192.168.1.10:5006   # your Actual server, as reachable from this container
ACTUAL_PASSWORD=                             # your Actual server password
ACTUAL_SYNC_ID=                              # Actual: Settings > Show advanced settings > Sync ID
# ACTUAL_BUDGET_PASSWORD=                    # only if the budget has end-to-end encryption on

# --- optional integrations ---
SIMPLEFIN_ACCESS_URL=                        # the same Access URL your Power Query uses
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# build-time: match your Actual server's version (see its footer / Settings > About)
ACTUAL_API_VERSION=
